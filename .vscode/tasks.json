{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译",
      "type": "shell",
      "command": "D:\\software\\devc++\\Dev-Cpp\\TDM-GCC-64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-O2",
        "-Wall",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silently",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "编译并运行",
      "type": "shell",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": "编译",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
